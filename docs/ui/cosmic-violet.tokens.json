{
  "$schema": "https://tokens.studio/schemas/1.0.0",
  "name": "VOID HORIZON / COSMIC VIOLET",
  "description": "UI-only palette from the approved design brief. Never apply these colors to world, ship, or environment assets.",
  "colors": {
    "primitive": {
      "deep-violet": "#171323",
      "dark-purple": "#20152F",
      "purple-surface": "#302044",
      "cosmic-purple": "#7139A8",
      "luminous-violet": "#A45BDF",
      "magenta-accent": "#C04DDB",
      "lavender": "#C9A5F0",
      "ice-white": "#F1DFFF",
      "muted-text": "#A99AB8"
    },
    "semantic": {
      "background/canvas": "{colors.primitive.deep-violet}",
      "background/panel": "{colors.primitive.dark-purple}",
      "surface/raised": "{colors.primitive.purple-surface}",
      "action/selected": "{colors.primitive.cosmic-purple}",
      "action/active": "{colors.primitive.luminous-violet}",
      "feedback/special": "{colors.primitive.magenta-accent}",
      "text/primary": "{colors.primitive.ice-white}",
      "text/secondary": "{colors.primitive.muted-text}",
      "text/tertiary": "{colors.primitive.lavender}"
    }
  },
  "typography": {
    "display": { "family": "Rajdhani", "weight": "SemiBold", "size": 40, "lineHeight": 48, "tracking": 1.5 },
    "heading": { "family": "Rajdhani", "weight": "SemiBold", "size": 28, "lineHeight": 34, "tracking": 0.8 },
    "section": { "family": "Rajdhani", "weight": "Medium", "size": 20, "lineHeight": 26, "tracking": 0.5 },
    "body": { "family": "Inter", "weight": "Regular", "size": 16, "lineHeight": 24, "tracking": 0 },
    "technical": { "family": "IBM Plex Mono", "weight": "Medium", "size": 12, "lineHeight": 16, "tracking": 0.8 },
    "numeric": { "family": "Rajdhani", "weight": "Bold", "size": 56, "lineHeight": 58, "tracking": -1 }
  },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "2xl": 32, "3xl": 48, "4xl": 64 },
  "radius": { "sm": 4, "md": 8, "lg": 12, "xl": 16 },
  "responsive": { "desktop": "1920x1080", "qhd": "2560x1440", "hd": "1600x900", "ultrawide": "2560x1080", "safeMargin": 64 }
}

